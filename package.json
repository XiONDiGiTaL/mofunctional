{
  "name": "mofunctional",
  "version": "0.9.0",
  "private": true,
  "description": "MO: FUNCTIONAL \u2014 a 90s-era dark comedy life-management simulation. Keep the job. Keep the apartment. Keep it together.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "dev": "python3 -m http.server 8080",
    "serve": "npx --yes serve -l 8080 .",
    "check": "node scripts/check-syntax.mjs && node scripts/stamp.mjs --check",
    "stamp": "node scripts/stamp.mjs",
    "test": "node scripts/test-systems.mjs && node scripts/test-district.mjs && node scripts/test-i18n.mjs",
    "i18n": "node scripts/i18n-catalog.mjs"
  },
  "keywords": [
    "game",
    "threejs",
    "90s-3d",
    "life-sim",
    "dark-comedy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiONDiGiTaL/mofunctional"
  }
}
